<!DOCTYPE html>
<html lang="en" data-theme="infinite">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="stylesheet" href="{{ '/styles/output.css' | url }}">
  {% if extraCss %}{% for css in extraCss %}
  <link rel="stylesheet" href="{{ css | url }}">
  {% endfor %}{% endif %}
  <script src="//embed.typeform.com/next/embed.js"></script>
  <script src="https://f.convertkit.com/ckjs/ck.5.js"></script>
  <script src="https://player.vimeo.com/api/player.js"></script>
</head>
<body class="min-h-screen flex flex-col{% if bodyClass %} {{ bodyClass }}{% endif %}">
  {% if bodyClass == 'space-theme' %}
  <canvas id="space-bg" style="position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;"></canvas>
  <div style="position:fixed;inset:0;z-index:1;pointer-events:none;overflow:hidden;">
    <div id="nb1" style="position:absolute;width:800px;height:800px;border-radius:50%;background:radial-gradient(circle,rgba(112,87,232,.18) 0%,transparent 50%);top:5%;left:-15%;will-change:transform;filter:blur(40px);"></div>
    <div id="nb2" style="position:absolute;width:650px;height:650px;border-radius:50%;background:radial-gradient(circle,rgba(40,218,252,.13) 0%,transparent 50%);top:60%;right:-10%;will-change:transform;filter:blur(30px);"></div>
    <div id="nb3" style="position:absolute;width:550px;height:550px;border-radius:50%;background:radial-gradient(circle,rgba(71,143,249,.15) 0%,transparent 50%);top:40%;left:30%;will-change:transform;filter:blur(35px);"></div>
  </div>
  {% endif %}
<header class="sticky top-0 z-50">
    <nav class="navbar max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="navbar-start">
        {# Mobile hamburger #}
        <div class="dropdown lg:hidden">
          <div tabindex="0" role="button" class="btn btn-ghost btn-sm" style="color:white;">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </div>
          <ul tabindex="0" class="menu menu-sm dropdown-content mt-3 z-50 p-2 rounded-box w-36" style="background:rgba(6,6,26,0.92);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,0.08);">
            <li><a href="{{ '/about/' | url }}" style="color:rgba(255,255,255,.85);">About</a></li>
            <li><a href="{{ '/programs/' | url }}" style="color:rgba(255,255,255,.85);">Programs</a></li>
          </ul>
        </div>
        {# Desktop links #}
        <div class="hidden lg:flex">
          <a href="{{ '/about/' | url }}" class="btn btn-ghost btn-sm font-medium">About</a>
          <a href="{{ '/programs/' | url }}" class="btn btn-ghost btn-sm font-medium">Programs</a>
        </div>
      </div>
      <div class="navbar-center">
        <a href="{{ '/' | url }}" class="flex items-center gap-2 text-xl font-bold font-[family-name:var(--font-display)]">
          <img src="{{ '/images/IP-LOGOMARK-nav.png' | url }}" alt="{{ site.name }}" class="h-8 w-auto">
          {{ site.name }}
        </a>
      </div>
      <div class="navbar-end">
        <a href="{{ '/programs/' | url }}" class="btn btn-sm btn-primary text-white font-semibold">Curious?</a>
      </div>
    </nav>
  </header>

  <main class="flex-grow">
    {{ content | safe }}
  </main>

<footer class="bg-neutral text-neutral-content py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p>&copy; {{ 2026 }} {{ site.name }}. All rights reserved.</p>
    </div>
  </footer>
  {% if extraJs %}{% for js in extraJs %}
  <script src="{{ js | url }}"></script>
  {% endfor %}{% endif %}
</body>
</html>
