---
layout: base.njk
title: Infinite Potential
bodyClass: space-theme
extraCss:
  - /assets/css/index.css
extraJs:
  - /assets/js/index.js
  - /assets/js/space-bg.js
  - /assets/js/shooting-stars.js
  - /assets/js/nebula-parallax.js
  - /assets/js/section-stars.js
  - /assets/js/cta-stars.js
---

{# Shooting stars container #}
<div id="shooting-stars" style="position:fixed;inset:0;z-index:5;pointer-events:none;overflow:hidden;"></div>

{# ============================================================
   HERO  — scroll-to-unlock + expand-to-fullscreen video
   ============================================================ #}
<section id="hero-section" class="relative" style="height:250vh;background:#000;">
  <div id="hero-sticky" style="position:sticky;top:0;height:100vh;overflow:hidden;">
    <canvas id="hero-stars" class="absolute inset-0 w-full h-full"></canvas>

    <div id="hero-text" class="relative z-10 text-center max-w-4xl mx-auto px-4" style="padding-top:5rem;">
      <h1 class="text-5xl lg:text-6xl font-bold font-[family-name:var(--font-display)] mb-2 leading-tight" style="text-shadow:0 0 80px rgba(112,87,232,.35);">
        <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">We believe you have<br />infinite potential.</span>
        <span id="hero-subtitle" class="text-white block mt-2" style="opacity:0;transform:translateY(16px);transition:opacity .4s ease,transform .4s ease;">We help you unlock it.</span>
      </h1>
    </div>

    <div id="hero-video" style="position:absolute;left:50%;top:50%;transform:translate(-50%,-45%) scale(0.5);opacity:0;width:80%;max-width:1100px;aspect-ratio:16/9;border-radius:2rem;overflow:hidden;box-shadow:0 0 60px rgba(71,143,249,.2),0 30px 60px rgba(0,0,0,.6);z-index:1;">
      <iframe
        id="hero-iframe"
        src=""
data-src="https://player.vimeo.com/video/849443158?autoplay=1&muted=1&controls=0&title=0&byline=0&portrait=0&loop=0"
        style="position:absolute;inset:0;width:100%;height:100%;display:none;border:0;"
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen></iframe>
      <div id="video-facade" class="absolute inset-0 flex items-center justify-center" style="background:#06061a;">
        <div id="play-btn" style="width:88px;height:88px;border-radius:50%;background:rgba(255,255,255,.12);border:2px solid rgba(255,255,255,.35);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(6px);">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13 9L29 18L13 27V9Z" fill="white"/>
          </svg>
        </div>
      </div>
    </div>

    <div id="video-controls" style="display:none;position:absolute;left:50%;bottom:2rem;transform:translateX(-50%);z-index:10;display:none;gap:0.5rem;">
      <button id="unmute-btn" class="btn btn-sm font-medium" style="background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);color:white;backdrop-filter:blur(6px);" onclick="var p=new Vimeo.Player(document.getElementById('hero-iframe'));p.setMuted(false);this.style.display='none';">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right:6px;"><path d="M11 5L6 9H2v6h4l5 4V5z"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
        Unmute
      </button>
      <button id="playpause-btn" class="btn btn-sm font-medium" style="background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.25);color:white;backdrop-filter:blur(6px);" onclick="var p=new Vimeo.Player(document.getElementById('hero-iframe'));var b=this;p.getPaused().then(function(paused){if(paused){p.play();b.innerHTML='<svg width=18 height=18 viewBox=&quot;0 0 24 24&quot; fill=&quot;none&quot; stroke=&quot;currentColor&quot; stroke-width=&quot;2&quot;><rect x=6 y=4 width=4 height=16/><rect x=14 y=4 width=4 height=16/></svg>';}else{p.pause();b.innerHTML='<svg width=18 height=18 viewBox=&quot;0 0 24 24&quot; fill=&quot;currentColor&quot;><path d=&quot;M8 5v14l11-7L8 5z&quot;/></svg>';}});">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
      </button>
    </div>

  </div>
</section>


{# ============================================================
   APPROACH SECTION
   ============================================================ #}
<section class="relative py-16 lg:py-24 overflow-hidden" style="background:#070718;">
  <canvas class="section-stars absolute inset-0 w-full h-full" style="pointer-events:none;z-index:0;"></canvas>
  {# Planet — blurred radial blob evoking a distant world #}
  <div style="position:absolute;top:-100px;right:-100px;width:350px;height:350px;border-radius:50%;background:radial-gradient(circle at 35% 35%,rgba(71,143,249,.18) 0%,rgba(112,87,232,.08) 40%,transparent 65%);filter:blur(40px);pointer-events:none;"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <h2 class="text-3xl lg:text-4xl font-bold font-[family-name:var(--font-display)] text-white mb-6" style="text-shadow:0 0 50px rgba(71,143,249,.5);">Coaching. Culture. Consulting. <br />All three. Always.</h2>
    <p class="text-lg text-white/70 mb-4 max-w-3xl mx-auto leading-relaxed">Most firms choose a lane &mdash; people or performance. We don&rsquo;t. Because real, lasting change only happens when human connection and strategic execution move together.</p>
    <p class="text-lg text-white/70 mb-12 max-w-3xl mx-auto leading-relaxed">We start with the individual, expand to the team, and build outward into culture and business results. It&rsquo;s not a linear process &mdash; it&rsquo;s a continuous loop.</p>
    <div class="flex justify-center mb-12">
      <img src="{{ '/images/IPCCC-transparent.png' | url }}" alt="Coaching, Culture, and Consulting framework" class="w-full max-w-2xl h-auto">
    </div>
    <div class="flex justify-center mt-8">
      <a href="{{ '/programs/' | url }}" class="btn btn-accent btn-lg text-white font-semibold">Curious?</a>
    </div>
  </div>
</section>


{# ============================================================
   NEWSLETTER SECTION
   ============================================================ #}
<section class="relative overflow-hidden py-16 lg:py-24" style="background:#07071a;">
  <canvas class="section-stars absolute inset-0 w-full h-full" style="pointer-events:none;z-index:0;"></canvas>
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 100%,rgba(112,87,232,.12) 0%,transparent 60%);pointer-events:none;"></div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <h2 class="text-4xl font-bold font-[family-name:var(--font-display)] text-white mb-6" style="text-shadow:0 0 40px rgba(112,87,232,.4);">Join a Community of Leaders<br>Who Look Inward</h2>
    <p class="text-lg mb-8 text-white/70 max-w-xl mx-auto">Every two weeks we share a piece of wisdom and a reflection prompt. It&rsquo;s a simple practice that compounds over time.<br />For leaders who know that change happens from the inside out.</p>
    <form action="https://app.kit.com/forms/9252338/subscriptions" class="seva-form formkit-form" method="post" data-sv-form="9252338" data-uid="8630c1aad3" data-format="inline" data-version="5">
      <ul class="formkit-alert formkit-alert-error" data-element="errors" data-group="alert"></ul>
      <div data-element="fields" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
        <input class="input bg-white/10 border border-white/20 text-white placeholder:text-white/40 flex-grow" name="email_address" aria-label="Email Address" placeholder="Email Address" required type="email">
        <button data-element="submit" class="btn btn-accent text-white">
          <div class="formkit-spinner"><div></div><div></div><div></div></div>
          <span>Join</span>
        </button>
      </div>
    </form>
  </div>
</section>

{# ============================================================
   CTA SECTION  — T.S. Eliot quote
   ============================================================ #}
<section class="relative overflow-hidden text-white py-16 lg:py-24" style="background:linear-gradient(135deg,rgba(112,87,232,.92),rgba(71,143,249,.92));">
  <canvas id="cta-stars" class="absolute inset-0 w-full h-full" style="opacity:.45;pointer-events:none;"></canvas>
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,rgba(40,218,252,.12) 0%,transparent 60%);pointer-events:none;"></div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <blockquote class="mb-10">
      <p class="text-2xl italic text-white/90 leading-relaxed">
        &ldquo;We shall not cease from exploration, and the end of all our exploring will be to arrive where we started and know the place for the first time.&rdquo;
      </p>
      <cite class="block mt-4 text-sm text-white/60 not-italic">&mdash; T.S. Eliot</cite>
    </blockquote>
    <h2 class="text-4xl font-bold font-[family-name:var(--font-display)]" style="text-shadow:0 0 40px rgba(255,255,255,.3);">What will you reach for?</h2>
  </div>
</section>

