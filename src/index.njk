---
layout: base.njk
title: Infinite Potential
bodyClass: space-theme
extraCss:
  - /assets/css/index.css
extraJs:
  - /assets/js/index.js
  - /assets/js/space-bg.js
  - /assets/js/shooting-stars.js
  - /assets/js/nebula-parallax.js
  - /assets/js/section-stars.js
  - /assets/js/cta-stars.js
  - /assets/js/testimonial-carousel.js
---

{# Shooting stars container #}
<div id="shooting-stars" style="position:fixed;inset:0;z-index:5;pointer-events:none;overflow:hidden;"></div>

{# ============================================================
   HERO  — scroll-to-unlock + expand-to-fullscreen video
   ============================================================ #}
<section id="hero-section" class="relative" style="height:250vh;background:#000;">
  <div id="hero-sticky" style="position:sticky;top:0;height:100vh;overflow:hidden;">
    <canvas id="hero-stars" class="absolute inset-0 w-full h-full"></canvas>

    <div id="hero-text" class="relative z-10 text-center max-w-4xl mx-auto px-4" style="padding-top:25vh;">
      <h1 class="text-6xl lg:text-6xl font-bold font-[family-name:var(--font-display)] mb-2 leading-tight" style="text-shadow:0 0 80px rgba(112,87,232,.35);">
        <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">You have infinite potential.</span>
        <span id="hero-subtitle" class="text-white block mt-2" style="opacity:0;transform:translateY(16px);transition:opacity .4s ease,transform .4s ease;">We help you unlock it.</span>
      </h1>
    </div>

    <div id="hero-video" style="position:absolute;left:50%;top:95%;transform:translate(-50%,-50%);width:80%;max-width:1100px;aspect-ratio:16/9;border-radius:2rem;overflow:hidden;z-index:1;">
      <img id="video-placeholder" src="{{ '/images/video-placeholder.png' | url }}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;">
      <iframe
        id="hero-iframe"
        src="https://player.vimeo.com/video/1199564290?controls=1&title=0&byline=0&portrait=0&loop=0&background=0"
        style="position:absolute;inset:0;width:100%;height:100%;border:0;background:#000;opacity:0;pointer-events:none;"
        allow="autoplay; fullscreen; picture-in-picture"
        allowfullscreen></iframe>
      <div id="video-facade" class="absolute inset-0 flex flex-col items-center justify-center gap-6 px-8" style="background:rgba(6,6,26,0.45);">
        <div id="play-btn" style="width:88px;height:88px;border-radius:50%;background:rgba(255,255,255,.12);border:2px solid rgba(255,255,255,.35);display:flex;align-items:center;justify-content:center;backdrop-filter:blur(6px);flex-shrink:0;cursor:pointer;opacity:0;pointer-events:none;transition:opacity .4s ease;">
          <svg width="36" height="36" viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M13 9L29 18L13 27V9Z" fill="white"/>
          </svg>
        </div>
        {# <p id="facade-title" class="text-white text-xl lg:text-2xl italic text-center max-w-xl leading-relaxed" style="text-shadow:0 0 40px rgba(112,87,232,.4);opacity:0;transition:opacity .6s ease;">Watch the story that changes everything.</p> #}
        <p id="facade-cta" class="text-white/60 text-sm tracking-widest uppercase" style="opacity:0;transition:opacity .6s ease;">Press Play to Witness Transformation</p>
      </div>
    </div>

  </div>
</section>


{# ============================================================
   APPROACH SECTION
   ============================================================ #}
<section class="relative py-16 lg:py-24 overflow-hidden" style="background:#070718;">
  <canvas class="section-stars absolute inset-0 w-full h-full" style="pointer-events:none;z-index:0;"></canvas>
  {# Planet — blurred radial blob evoking a distant world #}
  <div style="position:absolute;top:-100px;right:-100px;width:350px;height:350px;border-radius:50%;background:radial-gradient(circle at 35% 35%,rgba(71,143,249,.18) 0%,rgba(112,87,232,.08) 40%,transparent 65%);filter:blur(40px);pointer-events:none;"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <h2 class="text-3xl lg:text-4xl font-bold font-[family-name:var(--font-display)] text-white mb-4" style="text-shadow:0 0 50px rgba(71,143,249,.5);">Coaching. Culture. Consulting.</h2>
    <p class="text-lg text-white/70 mb-4 max-w-3xl mx-auto leading-relaxed">Organizations don&rsquo;t transform because of better spreadsheets, strategies, or systems alone. They transform when people grow, teams connect, and cultures evolve.</p>
    <p class="text-xl lg:text-2xl font-medium text-white/90 mb-8 max-w-3xl mx-auto">Humans Before Spreadsheets.</p>
    <p class="text-lg text-white/70 mb-12 max-w-3xl mx-auto leading-relaxed italic">We partner with leaders and organizations to unlock human potential, strengthen culture, and drive meaningful business results that last.</p>
    <div class="flex justify-center mt-8">
      <a href="{{ '/about/' | url }}" class="btn btn-accent btn-lg text-white font-semibold">Learn More</a>
    </div>
  </div>
</section>


{# ============================================================
   TESTIMONIALS CAROUSEL
   ============================================================ #}
<section class="relative py-16 lg:py-24 overflow-hidden" style="background:#09091e;">
  <canvas class="section-stars absolute inset-0 w-full h-full" style="pointer-events:none;z-index:0;"></canvas>
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 30% 50%,rgba(40,218,252,.08) 0%,transparent 55%);pointer-events:none;"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <h2 class="text-3xl lg:text-4xl font-bold font-[family-name:var(--font-display)] text-white mb-12 text-center" style="text-shadow:0 0 40px rgba(40,218,252,.35);">What Our Clients Say</h2>

    <div class="overflow-hidden">
      <div id="testimonial-track" style="display:flex;transition:transform .6s ease;">
        {% for t in testimonials %}
        <div class="testimonial-slide" style="padding:0 1rem;">
          <div class="card shadow-xl h-full" style="background:linear-gradient(135deg,rgba(112,87,232,.12),rgba(71,143,249,.08));border:1px solid rgba(255,255,255,.08);backdrop-filter:blur(8px);">
            <div class="card-body">
              <span style="font-size:3rem;line-height:1;color:rgba(40,218,252,.5);font-family:Georgia,serif;pointer-events:none;">&ldquo;</span>
              <p class="text-lg text-white/80 italic leading-relaxed mb-4" style="margin-top:-1rem;">{{ t.quote }}</p>
              <div>
                <p class="text-lg font-medium" style="color:#28dafc;">{{ t.name }}</p>
                <p class="text-base font-medium" style="color:rgba(40,218,252,.6);">{{ t.role }}</p>
              </div>
            </div>
          </div>
        </div>
        {% endfor %}
      </div>
    </div>

    <div id="testimonial-dots" class="flex items-center justify-center mt-8 gap-2"></div>
  </div>
</section>

{# ============================================================
   CTA SECTION  — Newsletter + T.S. Eliot quote
   ============================================================ #}
<section class="relative overflow-hidden text-white py-16 lg:py-24" style="background:linear-gradient(135deg,rgba(112,87,232,.92),rgba(71,143,249,.92));">
  <canvas id="cta-stars" class="absolute inset-0 w-full h-full" style="opacity:.45;pointer-events:none;"></canvas>
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,rgba(40,218,252,.12) 0%,transparent 60%);pointer-events:none;"></div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <h2 class="text-4xl font-bold font-[family-name:var(--font-display)] mb-6" style="text-shadow:0 0 40px rgba(255,255,255,.3);">Sign Up to Receive &ldquo;Flow State&rdquo;</h2>
    <p class="text-lg mb-8 text-white/80 max-w-xl mx-auto">In a world that never stops moving, Flow State offers a brief pause.<br /><br />Every other Friday, you'll receive a carefully curated story, insight, or reflection designed to help you live with greater presence, purpose, and perspective.</p>
    <form action="https://app.kit.com/forms/9252338/subscriptions" class="seva-form formkit-form" method="post" data-sv-form="9252338" data-uid="8630c1aad3" data-format="inline" data-version="5">
      <ul class="formkit-alert formkit-alert-error" data-element="errors" data-group="alert"></ul>
      <div data-element="fields" class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
        <input class="input bg-white/10 border border-white/20 text-white placeholder:text-white/40 flex-grow" name="email_address" aria-label="Email Address" placeholder="Email Address" required type="email">
        <button data-element="submit" class="btn btn-accent text-white">
          <div class="formkit-spinner"><div></div><div></div><div></div></div>
          <span>Join Flow State</span>
        </button>
      </div>
      <p class="text-xs text-white/40 mt-5">No spam. Just one thoughtful email every other Friday.</p>
    </form>

  </div>
</section>

{# ============================================================
   QUOTE SECTION
   ============================================================ #}
<section class="relative overflow-hidden text-white py-16 lg:py-24" style="background:#000;">
  <canvas class="section-stars absolute inset-0 w-full h-full" style="pointer-events:none;z-index:0;"></canvas>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <blockquote>
      <p class="text-2xl italic text-white/90 leading-relaxed">
        &ldquo;We shall not cease from exploration, and the end of all our exploring will be to arrive where we started and know the place for the first time.&rdquo;
      </p>
      <cite class="block mt-4 text-sm text-white/60 not-italic">&mdash; T.S. Eliot</cite>
    </blockquote>
  </div>
</section>

