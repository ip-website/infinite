{# ScrollyVideo.js library + init #}
<script src="https://cdn.jsdelivr.net/npm/scrolly-video@latest/dist/scrolly-video.js"></script>
<script>
(function () {
  var section = document.getElementById('scrolly-experience');
  if (!section || typeof ScrollyVideo === 'undefined') return;

  var steps = section.querySelectorAll('.scrolly-step');
  var captions = section.querySelectorAll('.scrolly-caption');
  var dots = section.querySelectorAll('.scrolly-dot');
  var hint = section.querySelector('.scrolly-hint');
  var total = steps.length;
  var currentIdx = -1;

  // Initialize ScrollyVideo with manual control — we drive it from our own scroll handler
  // so the layout (sticky stage + scrolling caption track) stays under our control.
  var sv = new ScrollyVideo({
    scrollyVideoContainer: 'scrolly-video',
    src: '{{ "/videos/scrolly.mp4" | url }}',
    sticky: false,
    full: false,
    trackScroll: false,
    cover: true
  });

  function update() {
    var rect = section.getBoundingClientRect();
    var scrollable = section.offsetHeight - window.innerHeight;
    var pct = scrollable > 0 ? Math.min(1, Math.max(0, -rect.top / scrollable)) : 0;

    // Drive the video scrub
    if (sv && typeof sv.setVideoPercentage === 'function') {
      sv.setVideoPercentage(pct);
    }

    // Fade scroll hint as soon as the user moves
    if (hint) hint.style.opacity = pct < 0.03 ? '1' : '0';

    // Active dot follows scroll segment; captions stay fully visible since they scroll naturally
    var idx = Math.min(Math.floor(pct * total), total - 1);
    if (idx === currentIdx) return;
    currentIdx = idx;

    dots.forEach(function (d, i) {
      d.style.backgroundColor = i === idx ? '#28dafc' : 'rgba(255,255,255,0.3)';
      d.style.transform = i === idx ? 'scale(1.5)' : 'scale(1)';
    });
  }

  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
}());
</script>

