<script>
(function () {
  var section = document.getElementById('process-section');
  if (!section) return;
  var steps = section.querySelectorAll('.process-step');
  var dots = section.querySelectorAll('.process-dot');
  var currentIndex = 0;

  function update() {
    var rect = section.getBoundingClientRect();
    var scrollable = section.offsetHeight - window.innerHeight;
    var progress = Math.min(1, Math.max(0, -rect.top / scrollable));
    var active = Math.min(Math.floor(progress * steps.length), steps.length - 1);

    if (active === currentIndex) return;
    currentIndex = active;

    steps.forEach(function (step, i) {
      if (i === active) {
        step.style.opacity = '1';
        step.style.transform = 'translateY(0)';
      } else if (i < active) {
        step.style.opacity = '0';
        step.style.transform = 'translateY(-60px)';
      } else {
        step.style.opacity = '0';
        step.style.transform = 'translateY(60px)';
      }
    });

    dots.forEach(function (dot, i) {
      dot.style.backgroundColor = i === active ? '#28dafc' : 'rgba(255,255,255,0.3)';
      dot.style.transform = i === active ? 'scale(1.5)' : 'scale(1)';
    });
  }

  window.addEventListener('scroll', update, { passive: true });
  update();
}());
</script>

