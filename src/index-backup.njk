{# ============================================================
   FIXED SPACE LAYER  (lives behind all content, z-index: -1)
   ============================================================ #}

{# Ambient star background — fills the viewport, stays fixed as you scroll #}
<canvas id="space-bg" style="position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none;"></canvas>

{# Nebula blobs — large soft colour clouds that parallax on scroll #}
<div style="position:fixed;inset:0;z-index:1;pointer-events:none;overflow:hidden;">
  <div id="nb1" style="position:absolute;width:800px;height:800px;border-radius:50%;background:radial-gradient(circle,rgba(112,87,232,.45) 0%,transparent 65%);top:5%;left:-15%;will-change:transform;"></div>
  <div id="nb2" style="position:absolute;width:650px;height:650px;border-radius:50%;background:radial-gradient(circle,rgba(40,218,252,.32) 0%,transparent 65%);top:60%;right:-10%;will-change:transform;"></div>
  <div id="nb3" style="position:absolute;width:550px;height:550px;border-radius:50%;background:radial-gradient(circle,rgba(71,143,249,.38) 0%,transparent 65%);top:40%;left:30%;will-change:transform;"></div>
</div>

{# Shooting stars container #}
<div id="shooting-stars" style="position:fixed;inset:0;z-index:5;pointer-events:none;overflow:hidden;"></div>

{# ============================================================
   HERO  — animated star canvas + scroll-to-unlock
   ============================================================ #}
<section class="relative min-h-screen flex flex-col items-center justify-start text-center px-4 pt-20 lg:pt-28 pb-24 overflow-hidden" style="background:#000;">
  <canvas id="hero-stars" class="absolute inset-0 w-full h-full"></canvas>
  <div class="max-w-4xl mx-auto relative z-10">
    <h1 class="text-5xl lg:text-6xl font-bold font-[family-name:var(--font-display)] mb-2 leading-tight" style="text-shadow:0 0 80px rgba(112,87,232,.35);position:relative;z-index:2;">
      <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">We believe you have<br />infinite potential.</span>
