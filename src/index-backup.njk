    </h1>
    <div id="hero-video" class="relative overflow-hidden mb-10" style="opacity:0;transform:scale(0.5) translateY(100px);width:130%;margin-left:-15%;padding-bottom:73.125%;border-radius:2rem;box-shadow:0 0 60px rgba(71,143,249,.2),0 30px 60px rgba(0,0,0,.6);z-index:1;">
      <iframe
        id="hero-iframe"
