---
layout: base.njk
title: About | Infinite Potential
bodyClass: space-theme
extraJs:
  - /assets/js/space-bg.js
  - /assets/js/hero-stars.js
  - /assets/js/section-stars.js
  - /assets/js/cta-stars.js
  - /assets/js/nebula-parallax.js
---

{# ============================================================
   PAGE HERO
   ============================================================ #}
<section class="relative py-24 lg:py-32 text-center overflow-hidden" style="background:#000;">
  <canvas id="hero-stars" class="absolute inset-0 w-full h-full"></canvas>
  <div class="max-w-3xl mx-auto px-4 relative z-10">
    {# <p class="text-xs font-bold uppercase tracking-widest mb-4" style="color:rgba(112,87,232,.8);">Our Story</p> #}
    <h1 class="text-5xl lg:text-6xl font-bold font-[family-name:var(--font-display)] leading-tight mb-6" style="text-shadow:0 0 80px rgba(112,87,232,.35);">
      <span class="bg-gradient-to-r from-primary via-secondary to-accent bg-clip-text text-transparent">Purpose driven<br />from the inside out.</span>
    </h1>
    <p class="text-xl text-white/70 leading-relaxed">We believe every leader and every team has more inside them<br /> than they've yet discovered.</p>
  </div>
</section>

{# ============================================================
   COACHES SECTION
   ============================================================ #}
<section class="relative py-16 lg:py-24 overflow-hidden" style="background:#070718;">
  <canvas class="section-stars absolute inset-0 w-full h-full" style="pointer-events:none;z-index:0;"></canvas>
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 30% 50%,rgba(40,218,252,.08) 0%,transparent 55%);pointer-events:none;"></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    {# <p class="text-xs font-bold uppercase tracking-widest mb-4 text-center" style="color:rgba(40,218,252,.8);">The Team</p> #}
    <h2 class="text-3xl lg:text-4xl font-bold font-[family-name:var(--font-display)] text-white mb-12 text-center" style="text-shadow:0 0 40px rgba(40,218,252,.35);">Who We Are</h2>
    <div class="flex flex-wrap justify-center gap-10">

      {% for coach in coaches %}
      <div class="flex flex-col items-center text-center" style="width:10rem;">
        <button
          class="coach-trigger w-24 h-24 rounded-full overflow-hidden mb-4 cursor-pointer border-0 p-0 bg-transparent"
          style="box-shadow:0 0 30px rgba(112,87,232,.35);transition:box-shadow .2s;"
          data-name="{{ coach.fullname | escape }}"
          data-image-url="{{ ('/images/' + coach.image) | url }}"
          data-passions="{{ coach.passions[0] | escape }}"
          data-highlights="{{ coach.highlights[0] | escape }}"
          data-focus="{{ coach['focus-areas'][0] | escape }}"
          aria-label="Learn more about {{ coach.fullname | escape }}"
        >
          <img src="{{ ('/images/' + coach.image) | url }}" alt="{{ coach.fullname }}" class="w-full h-full object-cover">
        </button>
        <h3 class="text-white font-bold mb-2">{{ coach.fullname }}</h3>
        {% for descriptor in coach.descriptors %}
        <p class="text-xs text-white/50">{{ descriptor }}</p>
        {% endfor %}
      </div>
      {% endfor %}

    </div>
  </div>

  {# Coach detail modal #}
  <dialog id="coach-modal" class="modal">
    <div class="modal-box max-w-3xl w-full relative" style="background:#0d0d2b;border:1px solid rgba(112,87,232,.35);">
      <form method="dialog">
        <button class="btn btn-sm btn-circle btn-ghost absolute right-3 top-3" style="color:rgba(255,255,255,.6);">✕</button>
      </form>
      <div class="flex flex-col items-center mb-8 pt-2">
        <img id="modal-img" src="" alt="" class="w-28 h-28 rounded-full object-cover mb-4" style="box-shadow:0 0 40px rgba(112,87,232,.5);">
        <h3 id="modal-name" class="text-2xl font-bold text-white"></h3>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest mb-3" style="color:rgba(112,87,232,.9);">My Passions</h4>
          <p id="modal-passions" class="text-sm leading-relaxed" style="color:rgba(255,255,255,.7);"></p>
        </div>
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest mb-3" style="color:rgba(40,218,252,.9);">Career Highlights</h4>
          <p id="modal-highlights" class="text-sm leading-relaxed" style="color:rgba(255,255,255,.7);"></p>
        </div>
        <div>
          <h4 class="text-xs font-bold uppercase tracking-widest mb-3" style="color:rgba(71,143,249,.9);">Focus Areas</h4>
          <p id="modal-focus" class="text-sm leading-relaxed" style="color:rgba(255,255,255,.7);"></p>
        </div>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>

  <script>
    document.querySelectorAll('.coach-trigger').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var modal = document.getElementById('coach-modal');
        document.getElementById('modal-img').src = btn.dataset.imageUrl;
        document.getElementById('modal-img').alt = btn.dataset.name;
        document.getElementById('modal-name').textContent = btn.dataset.name;
        document.getElementById('modal-passions').textContent = btn.dataset.passions;
        document.getElementById('modal-highlights').textContent = btn.dataset.highlights;
        document.getElementById('modal-focus').textContent = btn.dataset.focus;
        modal.showModal();
      });
      btn.addEventListener('mouseenter', function() {
        btn.style.boxShadow = '0 0 45px rgba(112,87,232,.7)';
      });
      btn.addEventListener('mouseleave', function() {
        btn.style.boxShadow = '0 0 30px rgba(112,87,232,.35)';
      });
    });
  </script>

</section>

{# ============================================================
   WHAT WE DO SECTION (programs grid)
   ============================================================ #}
<section class="relative py-16 lg:py-24 overflow-hidden" style="background:#09091e;">
  <canvas class="section-stars absolute inset-0 w-full h-full" style="pointer-events:none;z-index:0;"></canvas>
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 15% 50%,rgba(112,87,232,.18) 0%,transparent 50%),radial-gradient(ellipse at 90% 80%,rgba(40,218,252,.12) 0%,transparent 45%);pointer-events:none;"></div>
  <div style="position:absolute;bottom:-60px;left:-60px;width:240px;height:240px;border-radius:50%;background:radial-gradient(circle at 45% 45%,rgba(40,218,252,.14) 0%,rgba(71,143,249,.07) 40%,transparent 65%);filter:blur(30px);pointer-events:none;"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <h2 class="text-3xl lg:text-4xl font-bold font-[family-name:var(--font-display)] text-white mb-4 text-center" style="text-shadow:0 0 40px rgba(112,87,232,.4);">What We Do</h2>
    <p class="text-lg text-white/70 mb-12 max-w-2xl mx-auto leading-relaxed text-center">Every engagement is tailored to produce real, measurable outcomes.</p>
    <div class="grid md:grid-cols-2 gap-6 mb-8">

      <div class="card shadow-md" style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);backdrop-filter:blur(8px);">
        <div class="card-body">
          <div class="flex justify-between items-start">
            <h3 class="card-title text-lg text-white">Executive &amp; life coaching</h3>
            <span class="text-xs text-white/40 font-medium shrink-0 ml-4">2 hrs/month</span>
          </div>
          <hr class="border-white/10 my-3">
          <p class="text-white/70">Individualized 1:1 coaching for CEOs, executives, and pro coaches ready to grow into their next chapter.</p>
        </div>
      </div>

      <div class="card shadow-md" style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);backdrop-filter:blur(8px);">
        <div class="card-body">
          <div class="flex justify-between items-start">
            <h3 class="card-title text-lg text-white">Offsite: connect &amp; align</h3>
            <span class="text-xs text-white/40 font-medium shrink-0 ml-4">1&ndash;2 day offsite</span>
          </div>
          <hr class="border-white/10 my-3">
          <p class="text-white/70">Immersive 1&ndash;2 day experiences that build the relationships and shared understanding teams need to perform.</p>
        </div>
      </div>

      <div class="card shadow-md" style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);backdrop-filter:blur(8px);">
        <div class="card-body">
          <div class="flex justify-between items-start">
            <h3 class="card-title text-lg text-white">Modular custom training</h3>
            <span class="text-xs text-white/40 font-medium shrink-0 ml-4">2 hrs/month</span>
          </div>
          <hr class="border-white/10 my-3">
          <p class="text-white/70">Development sessions built around your team&rsquo;s priorities &mdash; facilitated, practical, and paired with curated reading.</p>
        </div>
      </div>

      <div class="card shadow-md" style="background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.09);backdrop-filter:blur(8px);">
        <div class="card-body">
          <div class="flex justify-between items-start">
            <h3 class="card-title text-lg text-white">Culture design</h3>
            <span class="text-xs text-white/40 font-medium shrink-0 ml-4">20 hours</span>
          </div>
          <hr class="border-white/10 my-3">
          <p class="text-white/70">From defining values to building accountability systems &mdash; a complete approach to culture that your team actually lives.</p>
        </div>
      </div>

    </div>

    {# Flagship #}
    <div class="card shadow-xl" style="background:linear-gradient(135deg,rgba(112,87,232,.75),rgba(71,143,249,.75));border:1px solid rgba(255,255,255,.2);backdrop-filter:blur(12px);box-shadow:0 0 50px rgba(112,87,232,.3),0 25px 50px rgba(0,0,0,.4);">
      <div class="card-body p-8">
        <p class="text-xs font-bold uppercase tracking-widest text-white/60 mb-3">Flagship program</p>
        <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-2 mb-1">
          <h3 class="text-2xl font-bold font-[family-name:var(--font-display)] text-white">Team unlock journey</h3>
          <span class="text-sm text-white/70 shrink-0 sm:text-right">2-day offsite + 4 hrs/month<br>over 6&ndash;12 months</span>
        </div>
        <hr class="border-white/20 my-4">
        <p class="text-white/90 text-lg leading-relaxed">Combine all four experiences into a comprehensive transformation. Emerge with a remade team &mdash; connected to each other, to your vision and values, and to a shared goal. All rowing in the same direction.</p>
      </div>
    </div>

  </div>
</section>

{# ============================================================
   CORE VALUES SECTION
   ============================================================ #}
<section class="relative py-16 lg:py-24 overflow-hidden" style="background:#09091e;">
  <canvas class="section-stars absolute inset-0 w-full h-full" style="pointer-events:none;z-index:0;"></canvas>
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 0%,rgba(112,87,232,.15) 0%,transparent 60%);pointer-events:none;"></div>

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    {# <p class="text-xs font-bold uppercase tracking-widest mb-4 text-center" style="color:rgba(112,87,232,.8);">What We Stand For</p> #}
    <h2 class="text-3xl lg:text-4xl font-bold font-[family-name:var(--font-display)] text-white mb-12 text-center" style="text-shadow:0 0 40px rgba(112,87,232,.4);">Our Core Values</h2>
    <div class="flex flex-wrap justify-center gap-6">

      <div class="card shadow-md value-card" style="background:rgba(112,87,232,.12);border:1px solid rgba(112,87,232,.3);backdrop-filter:blur(8px);">
        <div class="card-body p-6 items-center text-center">
          <h3 class="text-lg font-bold text-white mb-3">100%</h3>
          <p class="text-sm text-white/65 leading-relaxed">We are results oriented and give 100% to everything we do; we will be fulfilled by our maximum effort, not by an outcome.</p>
        </div>
      </div>

      <div class="card shadow-md value-card" style="background:rgba(112,87,232,.12);border:1px solid rgba(112,87,232,.3);backdrop-filter:blur(8px);">
        <div class="card-body p-6 items-center text-center">
          <h3 class="text-lg font-bold text-white mb-3">Gratitude + Grit = Greatness</h3>
          <p class="text-sm text-white/65 leading-relaxed">We bring in focus gratitude for all things while simultaneously being resilient; we believe this powerful combination yields greatness.</p>
        </div>
      </div>

      <div class="card shadow-md value-card" style="background:rgba(112,87,232,.12);border:1px solid rgba(112,87,232,.3);backdrop-filter:blur(8px);">
        <div class="card-body p-6 items-center text-center">
          <h3 class="text-lg font-bold text-white mb-3">Love In The Center</h3>
          <p class="text-sm text-white/65 leading-relaxed">Love the self. Love humans. Love learning. Love laughter. Love the process. Love our craft. Love the journey. And we try to love adversity :-).</p>
        </div>
      </div>

      <div class="card shadow-md value-card" style="background:rgba(112,87,232,.12);border:1px solid rgba(112,87,232,.3);backdrop-filter:blur(8px);">
        <div class="card-body p-6 items-center text-center">
          <h3 class="text-lg font-bold text-white mb-3">Truth + Transparency = Trust</h3>
          <p class="text-sm text-white/65 leading-relaxed">We strive to establish and nurture everlasting bonds of trust via truth and transparency.</p>
        </div>
      </div>

      <div class="card shadow-md value-card" style="background:rgba(112,87,232,.12);border:1px solid rgba(112,87,232,.3);backdrop-filter:blur(8px);">
        <div class="card-body p-6 items-center text-center">
          <h3 class="text-lg font-bold text-white mb-3">Flow Not Force</h3>
          <p class="text-sm text-white/65 leading-relaxed">Like water we will flow and move effortlessly. We strive to find the harmonious intersection of where we are desired and where we desire to be.</p>
        </div>
      </div>

    </div>
  </div>
</section>

{# ============================================================
   CTA SECTION
   ============================================================ #}
<section id="contact" class="relative overflow-hidden text-white py-16 lg:py-24" style="background:linear-gradient(135deg,rgba(112,87,232,.92),rgba(71,143,249,.92));">
  <canvas id="cta-stars" class="absolute inset-0 w-full h-full" style="opacity:.45;pointer-events:none;"></canvas>
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse at 50% 50%,rgba(40,218,252,.12) 0%,transparent 60%);pointer-events:none;"></div>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
    <h2 class="text-4xl font-bold font-[family-name:var(--font-display)] mb-4" style="text-shadow:0 0 40px rgba(255,255,255,.3);">Ready to unlock your potential?</h2>
    <p class="text-lg text-white/80 mb-8">Let&rsquo;s start a conversation.</p>
    <a href="{{ '/connect/' | url }}" class="btn btn-lg font-bold" style="background:#7057e8;color:white;border:none;box-shadow:0 0 30px rgba(255,255,255,.25);">Connect With Us</a>
  </div>
</section>

